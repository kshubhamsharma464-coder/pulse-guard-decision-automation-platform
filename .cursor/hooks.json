{
  "version": 1,
  "hooks": {
    "sessionStart": [
      {
        "command": "py -3.14 .cursor/hooks/log_writer.py session_start"
      }
    ],
    "beforeSubmitPrompt": [
      {
        "command": "py -3.14 .cursor/hooks/log_writer.py prompt"
      }
    ],
    "postToolUse": [
      {
        "command": "py -3.14 .cursor/hooks/log_writer.py tool_use"
      }
    ],
    "postToolUseFailure": [
      {
        "command": "py -3.14 .cursor/hooks/log_writer.py tool_failure"
      }
    ],
    "afterAgentResponse": [
      {
        "command": "py -3.14 .cursor/hooks/log_writer.py response"
      }
    ],
    "sessionEnd": [
      {
        "command": "py -3.14 .cursor/hooks/log_writer.py session_end"
      }
    ]
  }
}
