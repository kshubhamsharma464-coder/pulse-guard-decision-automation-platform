{
  "rule_set_name": "customer_sla_rules_vast",
  "version": "1.0",
  "domain": "problem_statement_4_decision_automation_platform",
  "description": "A broad, extensible rule set for customer and SLA decisioning with mixed priorities, outcomes, and explainability.",
  "rules": [
    { "rule_id": "CSR-001", "name": "Enterprise Priority", "priority": 100, "enabled": true,
      "when": { "all": [ { "field": "customer.segment", "op": "equals", "value": "enterprise" } ] },
      "then": { "decision": "approve", "action": "escalate", "score_delta": 30, "reason": "Enterprise customers receive priority handling." } },
    { "rule_id": "CSR-002", "name": "Gold Priority", "priority": 95, "enabled": true,
      "when": { "all": [ { "field": "customer.tier", "op": "equals", "value": "gold" } ] },
      "then": { "decision": "approve", "action": "fast_track", "score_delta": 20, "reason": "Gold tier customers get faster processing." } },
    { "rule_id": "CSR-003", "name": "Platinum Priority", "priority": 98, "enabled": true,
      "when": { "all": [ { "field": "customer.tier", "op": "equals", "value": "platinum" } ] },
      "then": { "decision": "approve", "action": "fast_track", "score_delta": 35, "reason": "Platinum customers receive top priority." } },
    { "rule_id": "CSR-004", "name": "SLA Critical Window", "priority": 90, "enabled": true,
      "when": { "all": [ { "field": "sla.hours_remaining", "op": "lte", "value": 2 } ] },
      "then": { "decision": "approve", "action": "urgent_review", "score_delta": 25, "reason": "Requests near SLA expiry need urgent attention." } },
    { "rule_id": "CSR-005", "name": "SLA Warning Window", "priority": 80, "enabled": true,
      "when": { "all": [ { "field": "sla.hours_remaining", "op": "lte", "value": 8 } ] },
      "then": { "decision": "review", "action": "prioritize", "score_delta": 15, "reason": "Requests with limited SLA time should be prioritized." } },
    { "rule_id": "CSR-006", "name": "Business Hours Processing", "priority": 60, "enabled": true,
      "when": { "all": [ { "field": "request.submitted_hour", "op": "gte", "value": 9 }, { "field": "request.submitted_hour", "op": "lt", "value": 18 } ] },
      "then": { "decision": "approve", "action": "normal_queue", "score_delta": 5, "reason": "Requests submitted during business hours are handled normally." } },
    { "rule_id": "CSR-007", "name": "After Hours Delay", "priority": 55, "enabled": true,
      "when": { "any": [ { "field": "request.submitted_hour", "op": "lt", "value": 9 }, { "field": "request.submitted_hour", "op": "gte", "value": 18 } ] },
      "then": { "decision": "review", "action": "queue_for_next_day", "score_delta": -5, "reason": "After-hours requests are deferred unless urgent." } },
    { "rule_id": "CSR-008", "name": "High Severity Incident", "priority": 99, "enabled": true,
      "when": { "all": [ { "field": "request.severity", "op": "equals", "value": "critical" } ] },
      "then": { "decision": "approve", "action": "escalate_immediately", "score_delta": 40, "reason": "Critical incidents require immediate escalation." } },
    { "rule_id": "CSR-009", "name": "Medium Severity Incident", "priority": 70, "enabled": true,
      "when": { "all": [ { "field": "request.severity", "op": "equals", "value": "medium" } ] },
      "then": { "decision": "review", "action": "assign_to_specialist", "score_delta": 10, "reason": "Medium severity incidents should be reviewed by a specialist." } },
    { "rule_id": "CSR-010", "name": "Low Severity Incident", "priority": 40, "enabled": true,
      "when": { "all": [ { "field": "request.severity", "op": "equals", "value": "low" } ] },
      "then": { "decision": "approve", "action": "standard_processing", "score_delta": 0, "reason": "Low severity incidents can follow the standard path." } },
    { "rule_id": "CSR-011", "name": "Repeated SLA Breach", "priority": 92, "enabled": true,
      "when": { "all": [ { "field": "customer.sla_breaches_30d", "op": "gte", "value": 2 } ] },
      "then": { "decision": "review", "action": "manual_review", "score_delta": -10, "reason": "Repeated recent SLA breaches require manual review." } },
    { "rule_id": "CSR-012", "name": "Frequent Support Contact", "priority": 65, "enabled": true,
      "when": { "all": [ { "field": "customer.tickets_7d", "op": "gte", "value": 5 } ] },
      "then": { "decision": "review", "action": "investigate_patterns", "score_delta": 8, "reason": "High ticket volume may indicate a broader issue." } },
    { "rule_id": "CSR-013", "name": "Payment Risk Hold", "priority": 85, "enabled": true,
      "when": { "all": [ { "field": "customer.payment_status", "op": "equals", "value": "delinquent" } ] },
      "then": { "decision": "deny", "action": "hold_processing", "score_delta": -30, "reason": "Delinquent accounts are placed on hold." } },
    { "rule_id": "CSR-014", "name": "Verified Account Bonus", "priority": 50, "enabled": true,
      "when": { "all": [ { "field": "customer.verified", "op": "equals", "value": true } ] },
      "then": { "decision": "approve", "action": "increase_trust", "score_delta": 12, "reason": "Verified customers receive a trust bonus." } },
    { "rule_id": "CSR-015", "name": "Unverified Account Review", "priority": 72, "enabled": true,
      "when": { "all": [ { "field": "customer.verified", "op": "equals", "value": false } ] },
      "then": { "decision": "review", "action": "manual_check", "score_delta": -8, "reason": "Unverified accounts need manual check." } },
    { "rule_id": "CSR-016", "name": "Large Amount Threshold", "priority": 88, "enabled": true,
      "when": { "all": [ { "field": "request.amount", "op": "gt", "value": 100000 } ] },
      "then": { "decision": "review", "action": "high_value_review", "score_delta": -5, "reason": "High-value requests require additional review." } },
    { "rule_id": "CSR-017", "name": "Small Amount Auto Process", "priority": 45, "enabled": true,
      "when": { "all": [ { "field": "request.amount", "op": "lte", "value": 5000 } ] },
      "then": { "decision": "approve", "action": "auto_process", "score_delta": 10, "reason": "Low-value requests can be auto-processed." } },
    { "rule_id": "CSR-018", "name": "Recurring Customer Boost", "priority": 58, "enabled": true,
      "when": { "all": [ { "field": "customer.orders_90d", "op": "gte", "value": 3 } ] },
      "then": { "decision": "approve", "action": "reward_loyalty", "score_delta": 14, "reason": "Repeat customers get a modest boost." } },
    { "rule_id": "CSR-019", "name": "New Customer Caution", "priority": 57, "enabled": true,
      "when": { "all": [ { "field": "customer.account_age_days", "op": "lt", "value": 30 } ] },
      "then": { "decision": "review", "action": "watchlist", "score_delta": -12, "reason": "Very new accounts may need extra scrutiny." } },
    { "rule_id": "CSR-020", "name": "VIP Escalation", "priority": 97, "enabled": true,
      "when": { "all": [ { "field": "customer.tags", "op": "contains", "value": "vip" } ] },
      "then": { "decision": "approve", "action": "vip_queue", "score_delta": 28, "reason": "VIP customers are routed to the VIP queue." } },
    { "rule_id": "CSR-021", "name": "Fraud Risk Block", "priority": 100, "enabled": true,
      "when": { "all": [ { "field": "risk.fraud_score", "op": "gte", "value": 90 } ] },
      "then": { "decision": "deny", "action": "block", "score_delta": -50, "reason": "Very high fraud risk is blocked." } },
    { "rule_id": "CSR-022", "name": "Moderate Fraud Risk Review", "priority": 89, "enabled": true,
      "when": { "all": [ { "field": "risk.fraud_score", "op": "gte", "value": 60 }, { "field": "risk.fraud_score", "op": "lt", "value": 90 } ] },
      "then": { "decision": "review", "action": "risk_check", "score_delta": -20, "reason": "Moderate fraud risk needs manual review." } },
    { "rule_id": "CSR-023", "name": "Healthy Risk Bonus", "priority": 52, "enabled": true,
      "when": { "all": [ { "field": "risk.fraud_score", "op": "lt", "value": 30 } ] },
      "then": { "decision": "approve", "action": "trust_bonus", "score_delta": 16, "reason": "Low risk requests gain trust points." } },
    { "rule_id": "CSR-024", "name": "Holiday Delay", "priority": 35, "enabled": true,
      "when": { "all": [ { "field": "request.date", "op": "in_holiday_period", "value": true } ] },
      "then": { "decision": "review", "action": "defer_if_nonurgent", "score_delta": -4, "reason": "Holiday-period requests may be deferred." } },
    { "rule_id": "CSR-025", "name": "Weekend Delay", "priority": 34, "enabled": true,
      "when": { "all": [ { "field": "request.day_of_week", "op": "in", "value": ["saturday", "sunday"] } ] },
      "then": { "decision": "review", "action": "defer", "score_delta": -3, "reason": "Weekend submissions may wait until business hours." } },
    { "rule_id": "CSR-026", "name": "Urgent Keyword Match", "priority": 75, "enabled": true,
      "when": { "any": [ { "field": "request.title", "op": "contains", "value": "urgent" }, { "field": "request.description", "op": "contains", "value": "urgent" } ] },
      "then": { "decision": "approve", "action": "raise_priority", "score_delta": 18, "reason": "Urgent requests are prioritized." } },
    { "rule_id": "CSR-027", "name": "Escalation Keyword Match", "priority": 76, "enabled": true,
      "when": { "any": [ { "field": "request.title", "op": "contains", "value": "escalate" }, { "field": "request.description", "op": "contains", "value": "escalate" } ] },
      "then": { "decision": "review", "action": "route_to_manager", "score_delta": 9, "reason": "Escalation keywords trigger manager review." } },
    { "rule_id": "CSR-028", "name": "Duplicate Request Guard", "priority": 93, "enabled": true,
      "when": { "all": [ { "field": "request.is_duplicate", "op": "equals", "value": true } ] },
      "then": { "decision": "deny", "action": "reject_duplicate", "score_delta": -25, "reason": "Duplicate requests are rejected." } },
    { "rule_id": "CSR-029", "name": "Missing Required Data", "priority": 94, "enabled": true,
      "when": { "all": [ { "field": "request.is_complete", "op": "equals", "value": false } ] },
      "then": { "decision": "review", "action": "request_more_info", "score_delta": -15, "reason": "Incomplete requests need more information." } },
    { "rule_id": "CSR-030", "name": "SLA Compliant Fast Path", "priority": 77, "enabled": true,
      "when": { "all": [ { "field": "sla.breached", "op": "equals", "value": false }, { "field": "sla.hours_remaining", "op": "gt", "value": 24 } ] },
      "then": { "decision": "approve", "action": "fast_path", "score_delta": 12, "reason": "Healthy SLA buffer allows fast processing." } }
  ],
  "response_template": {
    "request_id": "string",
    "rules_evaluated": [ { "rule_id": "string", "matched": true, "priority": 0, "reason": "string" } ],
    "rules_matched": ["string"],
    "rules_rejected": ["string"],
    "final_decision": { "decision": "approve|review|deny", "action": "string", "score": 0, "explanation": "string" }
  }
}
