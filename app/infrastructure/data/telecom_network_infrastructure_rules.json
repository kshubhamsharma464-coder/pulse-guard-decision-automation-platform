{
  "ruleSetId": "telecom-network-infrastructure-rules",
  "version": "1.0.0",
  "status": "active",
  "domain": "telecom-oss-bss",
  "description": "Network and infrastructure decision rules for telecom incidents with historical, operational, and SLA-based escalation to engineering.",
  "defaultConflictPolicy": "highest_priority_then_highest_confidence_then_newest_version",
  "evaluationMode": "all_matching_rules",
  "rules": [
    {"ruleId": "NET-INF-001", "version": "1.0.0", "name": "Critical Core Outage", "enabled": true, "priority": 1000, "confidence": 0.99, "category": "core_network",
      "when": {"and": [{"==": [{"var": "incident.networkLayer"}, "core"]}, {"in": [{"var": "incident.severity"}, ["critical", "major"]]}, {"==": [{"var": "incident.serviceImpact"}, true]}]},
      "then": {"decision": "escalate", "action": "activate_major_incident_bridge", "escalationTarget": "engineering_oncall", "priority": 1000, "confidence": 0.99, "explanation": "Core network outages with service impact require immediate engineering escalation."}},
    {"ruleId": "NET-INF-002", "version": "1.0.0", "name": "Same Tower Repeated Failure", "enabled": true, "priority": 980, "confidence": 0.98, "category": "radio_access",
      "when": {"and": [{"==": [{"var": "incident.assetType"}, "tower"]}, {">=": [{"var": "incident.failuresSameAsset7d"}, 3]}, {">=": [{"var": "incident.failuresSameAsset30d"}, 5]}, {"<=": [{"var": "incident.mtbfHours"}, 72]}]},
      "then": {"decision": "escalate", "action": "open_chronic_site_investigation", "escalationTarget": "ran_engineering", "priority": 980, "confidence": 0.98, "explanation": "A tower failing repeatedly over 7 and 30 days with low MTBF indicates chronic site instability."}},
    {"ruleId": "NET-INF-003", "version": "1.0.0", "name": "Incident Reopened Quickly", "enabled": true, "priority": 950, "confidence": 0.96, "category": "incident_management",
      "when": {"and": [{"==": [{"var": "incident.reopened"}, true]}, {"<=": [{"var": "incident.hoursSinceClosure"}, 48]}]},
      "then": {"decision": "escalate", "action": "route_to_problem_management", "escalationTarget": "problem_management", "priority": 950, "confidence": 0.96, "explanation": "A quick reopen suggests incomplete remediation or an unresolved root cause."}},
    {"ruleId": "NET-INF-004", "version": "1.0.0", "name": "Similar Incident Within One Hour", "enabled": true, "priority": 940, "confidence": 0.95, "category": "alarm_correlation",
      "when": {"and": [{"==": [{"var": "incident.similarIncidentExists"}, true]}, {"<=": [{"var": "incident.similarIncidentAgeMinutes"}, 60]}, {"==": [{"var": "incident.similarIncidentServiceId"}, {"var": "incident.serviceId"}]}]},
      "then": {"decision": "merge", "action": "attach_to_parent_incident", "escalationTarget": "current_owner", "priority": 940, "confidence": 0.95, "explanation": "Similar incidents within one hour on the same service should be correlated to a parent incident."}},
    {"ruleId": "NET-INF-005", "version": "1.0.0", "name": "Historical Outage Frequency", "enabled": true, "priority": 930, "confidence": 0.95, "category": "historical_analysis",
      "when": {"and": [{">=": [{"var": "incident.outagesSameService30d"}, 4]}, {">=": [{"var": "incident.outageMinutes30d"}, 180]}]},
      "then": {"decision": "escalate", "action": "problem_record_required", "escalationTarget": "engineering_oncall", "priority": 930, "confidence": 0.95, "explanation": "Repeated outages on the same service over 30 days indicate a systemic defect requiring engineering review."}},
    {"ruleId": "NET-INF-006", "version": "1.0.0", "name": "Low MTBF Chronic Equipment", "enabled": true, "priority": 970, "confidence": 0.97, "category": "root_cause_analysis",
      "when": {"and": [{"<=": [{"var": "incident.mtbfHours"}, 72]}, {">=": [{"var": "incident.equipmentFailures30d"}, 4]}]},
      "then": {"decision": "escalate", "action": "chronic_equipment_investigation", "escalationTarget": "engineering_oncall", "priority": 970, "confidence": 0.97, "explanation": "Low MTBF plus repeated failures is a strong indicator of chronic equipment deterioration."}},
    {"ruleId": "NET-INF-007", "version": "1.0.0", "name": "High MTTR Degradation", "enabled": true, "priority": 840, "confidence": 0.90, "category": "service_assurance",
      "when": {"and": [{">=": [{"var": "incident.mttrHours"}, 4]}, {"==": [{"var": "incident.serviceImpact"}, true]}]},
      "then": {"decision": "escalate", "action": "investigate_resolution_bottleneck", "escalationTarget": "noc_level_3", "priority": 840, "confidence": 0.90, "explanation": "Long MTTR with service impact suggests the incident needs higher-level technical intervention."}},
    {"ruleId": "NET-INF-008", "version": "1.0.0", "name": "Previous RCA Known Pattern", "enabled": true, "priority": 860, "confidence": 0.92, "category": "problem_management",
      "when": {"and": [{"==": [{"var": "incident.previousRcaExists"}, true]}, {"in": [{"var": "incident.previousRcaType"}, ["fiber_cut", "power_loss", "software_defect", "backhaul_congestion"]]}]},
      "then": {"decision": "route", "action": "apply_known_fix_playbook", "escalationTarget": "noc_level_2", "priority": 860, "confidence": 0.92, "explanation": "When RCA history matches a known operational pattern, the incident should follow the corresponding playbook."}},
    {"ruleId": "NET-INF-009", "version": "1.0.0", "name": "Maintenance Window Suppression", "enabled": true, "priority": 600, "confidence": 0.93, "category": "change_correlation",
      "when": {"and": [{"==": [{"var": "incident.inMaintenanceWindow"}, true]}, {"==": [{"var": "incident.changeApproved"}, true]}, {"==": [{"var": "incident.customerImpact"}, false]}]},
      "then": {"decision": "suppress", "action": "link_to_change_record", "escalationTarget": "change_management", "priority": 600, "confidence": 0.93, "explanation": "Approved maintenance without customer impact should be suppressed and tied to the change record."}},
    {"ruleId": "NET-INF-010", "version": "1.0.0", "name": "Unapproved Maintenance With Impact", "enabled": true, "priority": 960, "confidence": 0.97, "category": "change_violation",
      "when": {"and": [{"==": [{"var": "incident.inMaintenanceWindow"}, true]}, {"==": [{"var": "incident.changeApproved"}, false]}, {"==": [{"var": "incident.customerImpact"}, true]}]},
      "then": {"decision": "escalate", "action": "change_violation_alert", "escalationTarget": "engineering_oncall", "priority": 960, "confidence": 0.97, "explanation": "Customer-impacting faults during an unapproved maintenance window require immediate escalation."}},
    {"ruleId": "NET-INF-011", "version": "1.0.0", "name": "SLA Breach Imminent", "enabled": true, "priority": 910, "confidence": 0.94, "category": "sla_management",
      "when": {"and": [{"<=": [{"var": "incident.slaMinutesRemaining"}, 30]}, {"==": [{"var": "incident.isOpen"}, true]}]},
      "then": {"decision": "escalate", "action": "accelerate_resolution", "escalationTarget": "shift_lead", "priority": 910, "confidence": 0.94, "explanation": "An incident within 30 minutes of SLA breach should be accelerated."}},
    {"ruleId": "NET-INF-012", "version": "1.0.0", "name": "Core Service Customer Impact", "enabled": true, "priority": 900, "confidence": 0.93, "category": "customer_visible_service",
      "when": {"and": [{"in": [{"var": "incident.serviceType"}, ["voice", "mobile_data", "broadband"]]}, {"==": [{"var": "incident.customerImpact"}, true]}, {"==": [{"var": "incident.regionalImpact"}, true]}]},
      "then": {"decision": "escalate", "action": "major_incident_process", "escalationTarget": "engineering_oncall", "priority": 900, "confidence": 0.93, "explanation": "Customer-visible regional impact on core services warrants major-incident handling."}},
    {"ruleId": "NET-INF-013", "version": "1.0.0", "name": "Backhaul Congestion Peak", "enabled": true, "priority": 820, "confidence": 0.88, "category": "network_performance",
      "when": {"and": [{"==": [{"var": "incident.metricType"}, "throughput_degradation"]}, {">=": [{"var": "incident.linkUtilizationPct"}, 95]}, {">=": [{"var": "incident.durationMinutes"}, 15]}]},
      "then": {"decision": "route", "action": "capacity_review", "escalationTarget": "network_planning", "priority": 820, "confidence": 0.88, "explanation": "Sustained near-saturation on backhaul links should be routed to capacity planning."}},
    {"ruleId": "NET-INF-014", "version": "1.0.0", "name": "RAN Quality Degradation", "enabled": true, "priority": 830, "confidence": 0.89, "category": "ran_quality",
      "when": {"and": [{"==": [{"var": "incident.networkLayer"}, "ran"]}, {">=": [{"var": "incident.callDropRatePct"}, 8]}, {"<=": [{"var": "incident.rsrpDbm"}, -110]}]},
      "then": {"decision": "route", "action": "radio_optimization_review", "escalationTarget": "ran_engineering", "priority": 830, "confidence": 0.89, "explanation": "High drop rate and weak signal should be reviewed by RAN engineering."}},
    {"ruleId": "NET-INF-015", "version": "1.0.0", "name": "Low Impact Informational Alarm", "enabled": true, "priority": 100, "confidence": 0.80, "category": "noise_reduction",
      "when": {"and": [{"==": [{"var": "incident.severity"}, "info"]}, {"==": [{"var": "incident.customerImpact"}, false]}, {"==": [{"var": "incident.serviceImpact"}, false]}]},
      "then": {"decision": "suppress", "action": "log_only", "escalationTarget": "none", "priority": 100, "confidence": 0.80, "explanation": "Informational alarms without impact can be logged without escalation."}},
    {"ruleId": "NET-INF-016", "version": "1.0.0", "name": "Enterprise Account High Revenue Risk", "enabled": true, "priority": 915, "confidence": 0.94, "category": "business_impact",
      "when": {"and": [{"==": [{"var": "incident.customerSegment"}, "enterprise"]}, {">=": [{"var": "incident.revenueAtRiskUsd"}, 50000]}]},
      "then": {"decision": "escalate", "action": "priority_business_review", "escalationTarget": "engineering_oncall", "priority": 915, "confidence": 0.94, "explanation": "Enterprise incidents with significant revenue risk deserve priority escalation."}},
    {"ruleId": "NET-INF-017", "version": "1.0.0", "name": "Repeated Alarm on Same Node", "enabled": true, "priority": 940, "confidence": 0.95, "category": "alarm_correlation",
      "when": {"and": [{">=": [{"var": "incident.repeatAlarmsSameNode24h"}, 6]}, {">=": [{"var": "incident.repeatAlarmsSameNode7d"}, 10]}]},
      "then": {"decision": "escalate", "action": "node_health_investigation", "escalationTarget": "engineering_oncall", "priority": 940, "confidence": 0.95, "explanation": "Repeated alarms on the same node indicate a persistent equipment or software defect."}},
    {"ruleId": "NET-INF-018", "version": "1.0.0", "name": "Fast Recovery Candidate", "enabled": true, "priority": 720, "confidence": 0.84, "category": "service_recovery",
      "when": {"and": [{"<=": [{"var": "incident.mttrHours"}, 1.5]}, {"==": [{"var": "incident.customerImpact"}, false]}, {"==": [{"var": "incident.serviceImpact"}, true]}]},
      "then": {"decision": "route", "action": "standard_priority_queue", "escalationTarget": "noc_level_2", "priority": 720, "confidence": 0.84, "explanation": "Low-MTTR incidents with limited customer impact can remain in the standard operational queue."}},
    {"ruleId": "NET-INF-019", "version": "1.0.0", "name": "Chronic Equipment Failure", "enabled": true, "priority": 990, "confidence": 0.98, "category": "root_cause_analysis",
      "when": {"and": [{"<=": [{"var": "incident.mtbfHours"}, 24]}, {">=": [{"var": "incident.equipmentFailures30d"}, 5]}, {"==": [{"var": "incident.previousRcaExists"}, true]}]},
      "then": {"decision": "escalate", "action": "engineering_root_cause_review", "escalationTarget": "engineering_oncall", "priority": 990, "confidence": 0.98, "explanation": "Very low MTBF with repeated failures and prior RCA evidence indicates chronic equipment failure."}},
    {"ruleId": "NET-INF-020", "version": "1.0.0", "name": "Problem Management Trigger", "enabled": true, "priority": 880, "confidence": 0.92, "category": "itil_problem_management",
      "when": {"and": [{">=": [{"var": "incident.repeatFailures90d"}, 3]}, {"==": [{"var": "incident.isClosed"}, false]}]},
      "then": {"decision": "escalate", "action": "create_problem_record", "escalationTarget": "problem_management", "priority": 880, "confidence": 0.92, "explanation": "Repeated failures over 90 days should trigger problem management for permanent remediation."}}
  ],
  "priorityResolution": {"primaryKey": "priority", "secondaryKey": "confidence", "tertiaryKey": "version"}
}
