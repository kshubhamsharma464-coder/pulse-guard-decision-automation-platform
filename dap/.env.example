# Copy to .env and edit as needed. Every value here has a safe default in
# app/core/settings.py -- the app runs with zero configuration (in-memory
# backend, stub AI provider) if you never create a .env at all.

ENVIRONMENT=development

# -- Persistence ---------------------------------------------------
# "memory" (default): zero setup, exactly today's behavior, what every
#   existing test runs against. Ships with default roles/permissions/
#   viewer-operator-admin seeded in-process (see in_memory_role_repository.py).
# "postgres": swaps decision/rule-pack/audit/escalation/user/role/
#   permission/api-key repositories for SQLAlchemy-backed ones. Run
#   `alembic upgrade head` first (see docs/persistence.md, docs/auth.md).
#   Does NOT move the hot incident-evaluation rule set into Postgres yet
#   -- see dependencies.py's module docstring.
PERSISTENCE_BACKEND=postgres
DATABASE_URL=postgresql+psycopg2://decisiox:decisiox@localhost:5432/decisiox
DATABASE_POOL_SIZE=5
DATABASE_MAX_OVERFLOW=10
DATABASE_ECHO=false

# -- Rule source (Phase 2.5 dynamic Rule Management platform) -----------
# "static" (default): the hot evaluation path reads the fixed, in-memory
#   142-rule composite -- exactly the original behavior.
# "dynamic": reads a Postgres-backed, cache-fronted rule pack managed
#   through POST/GET /api/v1/rule-packs and /api/v1/rules -- rules go live
#   the moment they're activated, no restart. Requires PERSISTENCE_BACKEND=postgres.
#   See docs/rule-management.md.
RULE_SOURCE=dynamic
RULE_CACHE_TTL_SECONDS=10
DYNAMIC_RULE_SET_NAME=noc-default

# -- AI provider (Phase 3 -- rule authoring assist, rule documentation,
#    decision narration; see docs/ai-assist.md) -------------------------
# "stub" (default): deterministic, keyword/heuristic-based, zero network
#   calls, no key required -- works everywhere, including CI/sandboxes
#   with no outbound network access.
# "openai_compatible": works against ANY OpenAI-compatible chat-completions
#   endpoint -- a local Ollama/llama.cpp server (the default AI_BASE_URL
#   below), or real OpenAI/Azure OpenAI, by changing AI_BASE_URL and
#   AI_API_KEY only. Most local servers ignore AI_API_KEY entirely, but
#   the field is required by the request shape, hence the placeholder.
# "gemini_compatible": Google's Gemini REST API -- also set
#   AI_BASE_URL=https://generativelanguage.googleapis.com/v1beta,
#   AI_API_KEY to a real Gemini key, and AI_MODEL to a real Gemini model
#   name (e.g. gemini-1.5-flash) -- llama3 is only a sensible default for
#   the Ollama case above.
AI_PROVIDER=stub
AI_BASE_URL=http://localhost:11434/v1
AI_API_KEY=local-not-required
AI_MODEL=llama3
AI_TIMEOUT_SECONDS=30

# -- Auth (Phase 2) --------------------------------------------------
# AUTH_REQUIRED=false (default): every endpoint behaves exactly as it did
#   before Phase 2 -- no credentials needed. Anyone can still register/
#   login/create API keys; those just aren't *required* for anything yet.
# AUTH_REQUIRED=true: POST /api/v1/incidents/evaluate and the decision-read
#   endpoints start requiring a Bearer JWT or X-API-Key with the matching
#   permission (incidents:evaluate / decisions:read) -- see docs/auth.md.
JWT_SECRET=dev-only-insecure-secret-change-in-production
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_MINUTES=15
JWT_REFRESH_TOKEN_DAYS=7
AUTH_REQUIRED=false

# -- Rate limiting (Phase 2) ------------------------------------------
# Disabled by default. Fixed-window, in-memory, per API-key-or-IP -- see
# app/interfaces/api/middleware/rate_limit.py's docstring for the
# single-process caveat.
RATE_LIMIT_ENABLED=false
RATE_LIMIT_REQUESTS_PER_MINUTE=120

LOG_LEVEL=INFO
CORS_ALLOW_ORIGINS=*
