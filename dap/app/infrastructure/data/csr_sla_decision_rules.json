{
  "ruleSetId": "telecom-customer-sla-rules",
  "version": "1.0.0",
  "status": "active",
  "domain": "telecom-oss-bss",
  "description": "Customer and SLA rules for telecom incident decision automation with historical and operational escalation logic.",
  "defaultConflictPolicy": "highest_priority_then_highest_confidence_then_newest_version",
  "evaluationMode": "all_matching_rules",
  "outputSchema": {
    "incidentId": "string",
    "decision": "string",
    "priority": "number",
    "confidence": "number",
    "escalationTarget": "string",
    "matchedRules": [
      {"ruleId": "string", "version": "string", "priority": "number", "confidence": "number", "reason": "string"}
    ],
    "rejectedRules": [
      {"ruleId": "string", "version": "string", "reason": "string"}
    ],
    "explanation": "string"
  },
  "rules": [
    {"ruleId": "CSR-SLA-001", "version": "1.0.0", "name": "Gold Customer Priority Escalation", "enabled": true, "priority": 900, "confidence": 0.96, "category": "customer_priority",
      "when": {"and": [{"==": [{"var": "incident.customerTier"}, "gold"]}, {"==": [{"var": "incident.customerImpact"}, true]}, {"in": [{"var": "incident.severity"}, ["major", "critical"]]}]},
      "then": {"decision": "escalate", "action": "route_to_l2_and_cse", "escalationTarget": "customer_service_engineering", "priority": 900, "confidence": 0.96, "explanation": "Gold customers with major or critical impact should be escalated immediately."}},
    {"ruleId": "CSR-SLA-002", "version": "1.0.0", "name": "Platinum Customer Major Incident", "enabled": true, "priority": 920, "confidence": 0.97, "category": "customer_priority",
      "when": {"and": [{"==": [{"var": "incident.customerTier"}, "platinum"]}, {"==": [{"var": "incident.customerImpact"}, true]}, {"==": [{"var": "incident.serviceImpact"}, true]}]},
      "then": {"decision": "escalate", "action": "page_engineering_and_account_team", "escalationTarget": "engineering_oncall", "priority": 920, "confidence": 0.97, "explanation": "Platinum customers with service impact require urgent engineering escalation."}},
    {"ruleId": "CSR-SLA-003", "version": "1.0.0", "name": "SLA Breach Imminent", "enabled": true, "priority": 880, "confidence": 0.95, "category": "sla_management",
      "when": {"and": [{"<=": [{"var": "incident.slaMinutesRemaining"}, 30]}, {"==": [{"var": "incident.isOpen"}, true]}]},
      "then": {"decision": "escalate", "action": "accelerate_resolution", "escalationTarget": "shift_lead", "priority": 880, "confidence": 0.95, "explanation": "Incidents within 30 minutes of SLA breach should be accelerated."}},
    {"ruleId": "CSR-SLA-004", "version": "1.0.0", "name": "SLA Breach Already Occurred", "enabled": true, "priority": 950, "confidence": 0.99, "category": "sla_violation",
      "when": {"and": [{"==": [{"var": "incident.slaBreached"}, true]}, {"==": [{"var": "incident.isClosed"}, false]}]},
      "then": {"decision": "escalate", "action": "major_incident_process", "escalationTarget": "noc_level_3", "priority": 950, "confidence": 0.99, "explanation": "An active SLA breach requires immediate major-incident handling."}},
    {"ruleId": "CSR-SLA-005", "version": "1.0.0", "name": "Same Tower Repeated Failures", "enabled": true, "priority": 910, "confidence": 0.96, "category": "historical_failure",
      "when": {"and": [{"==": [{"var": "incident.assetType"}, "tower"]}, {">=": [{"var": "incident.failuresSameAsset7d"}, 3]}, {">=": [{"var": "incident.failuresSameAsset30d"}, 5]}]},
      "then": {"decision": "escalate", "action": "open_chronic_fault_investigation", "escalationTarget": "engineering_oncall", "priority": 910, "confidence": 0.96, "explanation": "A tower failing repeatedly within 7 and 30 days indicates a chronic asset problem."}},
    {"ruleId": "CSR-SLA-006", "version": "1.0.0", "name": "Incident Reopened Quickly", "enabled": true, "priority": 870, "confidence": 0.94, "category": "incident_management",
      "when": {"and": [{"==": [{"var": "incident.reopened"}, true]}, {"<=": [{"var": "incident.hoursSinceClosure"}, 72]}]},
      "then": {"decision": "escalate", "action": "route_to_problem_management", "escalationTarget": "problem_management", "priority": 870, "confidence": 0.94, "explanation": "An incident reopened within 72 hours should be investigated for unresolved root cause."}},
    {"ruleId": "CSR-SLA-007", "version": "1.0.0", "name": "Similar Incident Within One Hour", "enabled": true, "priority": 860, "confidence": 0.93, "category": "alarm_correlation",
      "when": {"and": [{"==": [{"var": "incident.similarIncidentExists"}, true]}, {"<=": [{"var": "incident.similarIncidentAgeMinutes"}, 60]}, {"==": [{"var": "incident.similarIncidentServiceId"}, {"var": "incident.serviceId"}]}]},
      "then": {"decision": "merge", "action": "attach_to_existing_incident", "escalationTarget": "current_owner", "priority": 860, "confidence": 0.93, "explanation": "Similar incidents within one hour on the same service should be merged to avoid duplicate handling."}},
    {"ruleId": "CSR-SLA-008", "version": "1.0.0", "name": "Historical Outage Frequency High", "enabled": true, "priority": 890, "confidence": 0.95, "category": "historical_analysis",
      "when": {"and": [{">=": [{"var": "incident.outagesSameService30d"}, 4]}, {">=": [{"var": "incident.outageMinutes30d"}, 180]}]},
      "then": {"decision": "escalate", "action": "problem_record_required", "escalationTarget": "engineering_oncall", "priority": 890, "confidence": 0.95, "explanation": "Repeated outages on the same service indicate a persistent defect requiring engineering review."}},
    {"ruleId": "CSR-SLA-009", "version": "1.0.0", "name": "Low MTTR Better Priority", "enabled": true, "priority": 700, "confidence": 0.85, "category": "service_assurance",
      "when": {"and": [{"<=": [{"var": "incident.mttrHours"}, 2]}, {"<=": [{"var": "incident.impactScope"}, "site"]}]},
      "then": {"decision": "route", "action": "standard_priority_queue", "escalationTarget": "noc_level_2", "priority": 700, "confidence": 0.85, "explanation": "Incidents with historically low MTTR and limited scope can stay in the standard queue."}},
    {"ruleId": "CSR-SLA-010", "version": "1.0.0", "name": "Low MTBF Chronic Equipment", "enabled": true, "priority": 940, "confidence": 0.96, "category": "root_cause_analysis",
      "when": {"and": [{"<=": [{"var": "incident.mtbfHours"}, 72]}, {">=": [{"var": "incident.equipmentFailures30d"}, 4]}]},
      "then": {"decision": "escalate", "action": "chronic_equipment_investigation", "escalationTarget": "engineering_oncall", "priority": 940, "confidence": 0.96, "explanation": "Low MTBF with repeated failures is a strong signal of chronic equipment deterioration."}},
    {"ruleId": "CSR-SLA-011", "version": "1.0.0", "name": "Previous RCA Indicates Known Issue", "enabled": true, "priority": 845, "confidence": 0.90, "category": "root_cause_analysis",
      "when": {"and": [{"==": [{"var": "incident.previousRcaExists"}, true]}, {"in": [{"var": "incident.previousRcaType"}, ["power", "fiber_cut", "software_defect", "backhaul_congestion"]]}]},
      "then": {"decision": "route", "action": "apply_known_fix_playbook", "escalationTarget": "noc_level_2", "priority": 845, "confidence": 0.90, "explanation": "Historical RCA matching a known fault pattern should reuse the corresponding remediation playbook."}},
    {"ruleId": "CSR-SLA-012", "version": "1.0.0", "name": "Maintenance Window Suppression", "enabled": true, "priority": 600, "confidence": 0.92, "category": "change_correlation",
      "when": {"and": [{"==": [{"var": "incident.inMaintenanceWindow"}, true]}, {"==": [{"var": "incident.changeApproved"}, true]}, {"==": [{"var": "incident.customerImpact"}, false]}]},
      "then": {"decision": "suppress", "action": "link_to_change_record", "escalationTarget": "change_management", "priority": 600, "confidence": 0.92, "explanation": "Incidents during approved maintenance windows with no customer impact can be suppressed and linked to change."}},
    {"ruleId": "CSR-SLA-013", "version": "1.0.0", "name": "Unapproved Maintenance With Impact", "enabled": true, "priority": 930, "confidence": 0.96, "category": "change_violation",
      "when": {"and": [{"==": [{"var": "incident.inMaintenanceWindow"}, true]}, {"==": [{"var": "incident.changeApproved"}, false]}, {"==": [{"var": "incident.customerImpact"}, true]}]},
      "then": {"decision": "escalate", "action": "change_violation_alert", "escalationTarget": "noc_level_3", "priority": 930, "confidence": 0.96, "explanation": "Customer-impacting incidents in an unapproved maintenance window need immediate escalation."}},
    {"ruleId": "CSR-SLA-014", "version": "1.0.0", "name": "Customer Complaint Received", "enabled": true, "priority": 800, "confidence": 0.89, "category": "customer_experience",
      "when": {"and": [{"==": [{"var": "incident.customerComplaintReceived"}, true]}, {"==": [{"var": "incident.isOpen"}, true]}]},
      "then": {"decision": "route", "action": "customer_visible_priority", "escalationTarget": "noc_level_2", "priority": 800, "confidence": 0.89, "explanation": "An active incident with customer complaints should receive elevated operational attention."}},
    {"ruleId": "CSR-SLA-015", "version": "1.0.0", "name": "Enterprise Customer With Repeated Incidents", "enabled": true, "priority": 915, "confidence": 0.95, "category": "customer_priority",
      "when": {"and": [{"==": [{"var": "incident.customerTier"}, "enterprise"]}, {">=": [{"var": "incident.customerIncidents30d"}, 3]}, {"==": [{"var": "incident.customerImpact"}, true]}]},
      "then": {"decision": "escalate", "action": "create_customer_problem_case", "escalationTarget": "engineering_oncall", "priority": 915, "confidence": 0.95, "explanation": "Repeated incidents affecting an enterprise customer warrant problem management and engineering escalation."}},
    {"ruleId": "CSR-SLA-016", "version": "1.0.0", "name": "Weekend Low-Impact Defer", "enabled": true, "priority": 300, "confidence": 0.80, "category": "service_window",
      "when": {"and": [{"in": [{"var": "incident.dayOfWeek"}, ["saturday", "sunday"]]}, {"==": [{"var": "incident.customerImpact"}, false]}, {"==": [{"var": "incident.severity"}, "minor"]}]},
      "then": {"decision": "defer", "action": "next_business_day_queue", "escalationTarget": "noc_level_1", "priority": 300, "confidence": 0.80, "explanation": "Minor incidents without customer impact can be deferred to the next business day."}},
    {"ruleId": "CSR-SLA-017", "version": "1.0.0", "name": "High Revenue Risk", "enabled": true, "priority": 905, "confidence": 0.94, "category": "business_impact",
      "when": {"and": [{">=": [{"var": "incident.revenueAtRiskUsd"}, 50000]}, {"==": [{"var": "incident.isOpen"}, true]}]},
      "then": {"decision": "escalate", "action": "priority_business_review", "escalationTarget": "engineering_oncall", "priority": 905, "confidence": 0.94, "explanation": "Incidents with significant revenue risk should be handled as high-priority business-impacting issues."}},
    {"ruleId": "CSR-SLA-018", "version": "1.0.0", "name": "Engineering Escalation for Chronic Fault", "enabled": true, "priority": 960, "confidence": 0.97, "category": "engineering_escalation",
      "when": {"and": [{">=": [{"var": "incident.repeatFailures90d"}, 4]}, {"<=": [{"var": "incident.mtbfHours"}, 48]}, {"==": [{"var": "incident.previousRcaExists"}, true]}]},
      "then": {"decision": "escalate", "action": "engineering_root_cause_review", "escalationTarget": "engineering_oncall", "priority": 960, "confidence": 0.97, "explanation": "A recurring fault with low MTBF and prior RCA evidence should be escalated to engineering."}}
  ]
}
