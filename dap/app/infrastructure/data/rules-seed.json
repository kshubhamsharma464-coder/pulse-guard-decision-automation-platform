{
  "ruleSet": {
    "name": "noc-default",
    "version": 3,
    "region": null,
    "status": "active"
  },
  "families": {
    "SAFETY_REGULATORY":       { "order": 1, "note": "Hard-stop rules, including security incidents (unauthorized access, DDoS). Always non-suppressible." },
    "NETWORK_IMPACT":          { "order": 2, "note": "Scale/scope of the technical outage, including asset-tier blast radius." },
    "CUSTOMER_VALUE":          { "order": 3, "note": "SLA tier, VIP, regulated/critical-sector customers." },
    "TEMPORAL":                { "order": 4, "note": "Time-of-day/week/year acceleration or relaxation." },
    "OPERATIONAL_FEASIBILITY": { "order": 5, "note": "Can we safely/practically/cheaply act right now." },
    "REPETITION_ESCALATION":   { "order": 6, "note": "Chronic assets, flapping, vendor-side recurrence, hardware lifecycle." },
    "SUPPRESSION":             { "order": 7, "note": "Maintenance, duplicates, storms, already-active parents, cross-incident correlation." },
    "COMPETITIVE_RESILIENCE":  { "order": 8, "note": "Churn/brand risk layered on top of the technical decision." },
    "COMPLIANCE":              { "order": 9, "note": "NOT part of the competing-rule loop. Evaluated as a constraint pass AFTER conflict resolution — narrows how a winning action executes, never competes for priority. See design doc §6.5." },
    "CLASSIFICATION":          { "order": 0, "note": "NOT a rule family at all — deterministic incidentType+assetTier to incidentCategory lookup, resolved via the incident_category_map table before any rule runs. Listed here only for completeness." }
  },
  "rules": [
    {
      "ruleCode": "R008",
      "name": "Emergency services network affected",
      "family": "SAFETY_REGULATORY",
      "familyOrder": 1,
      "description": "Incident impacts infrastructure carrying emergency call routing (112/911 equivalents) or hospital/emergency-service dependent links.",
      "priorityWeight": 100,
      "severityBand": "Critical",
      "contributionScore": 40,
      "conflictGroup": "priority",
      "conflictsWith": [],
      "isSuppressor": false,
      "nonSuppressible": true,
      "cooldownMinutes": 0,
      "conditions": { "==": [{ "var": "emergencyServicesAffected" }, true] },
      "exceptions": null,
      "actions": {
        "priority": "Critical",
        "dispatchEngineer": true,
        "notifyNOC": true,
        "rerouteTraffic": true,
        "customerNotification": true,
        "regulatoryReportingRequired": true
      },
      "mitigations": { "openWarRoom": true },
      "sequencing": null,
      "slaTarget": "10 minutes",
      "region": null, "tenantId": null, "ruleStatus": "ACTIVE",
      "createdBy": "platform-team", "approvedBy": "noc-governance-board", "lastReviewedAt": "2026-07-01T00:00:00Z"
    },
    {
      "ruleCode": "R020",
      "name": "Emergency alert broadcast dependency affected",
      "family": "SAFETY_REGULATORY",
      "familyOrder": 1,
      "description": "Cell Broadcast / emergency alert system dependency impacted — carries regulatory reporting obligations.",
      "priorityWeight": 98,
      "severityBand": "Critical",
      "contributionScore": 38,
      "conflictGroup": "priority",
      "conflictsWith": [],
      "isSuppressor": false,
      "nonSuppressible": true,
      "cooldownMinutes": 0,
      "conditions": { "==": [{ "var": "emergencyAlertSystemAffected" }, true] },
      "exceptions": null,
      "actions": {
        "priority": "Critical",
        "regulatoryReportingRequired": true,
        "regulatoryReportingDeadlineHours": 4,
        "notifyNOC": true,
        "dispatchEngineer": true
      },
      "mitigations": {},
      "sequencing": null,
      "slaTarget": null,
      "region": null, "tenantId": null, "ruleStatus": "ACTIVE",
      "createdBy": "platform-team", "approvedBy": "noc-governance-board", "lastReviewedAt": "2026-07-01T00:00:00Z"
    },
    {
      "ruleCode": "R015",
      "name": "Suspected DDoS / traffic anomaly",
      "family": "SAFETY_REGULATORY",
      "familyOrder": 1,
      "description": "Sudden traffic spike beyond 300% of rolling baseline combined with a multi-source-IP anomaly flag from the monitoring system.",
      "priorityWeight": 90,
      "severityBand": "Critical",
      "contributionScore": 35,
      "conflictGroup": "priority",
      "conflictsWith": ["R012"],
      "isSuppressor": false,
      "nonSuppressible": true,
      "cooldownMinutes": 0,
      "conditions": {
        "and": [
          { ">": [{ "var": "trafficSpikePercent" }, 300] },
          { "==": [{ "var": "anomalyFlag" }, true] }
        ]
      },
      "exceptions": null,
      "actions": {
        "priority": "Critical",
        "routeToSecurityTeam": true,
        "isolateNetworkSegment": true,
        "notifyNOC": true
      },
      "mitigations": { "openWarRoom": true, "throttleNonCriticalWork": true },
      "sequencing": null,
      "slaTarget": null,
      "region": null, "tenantId": null, "ruleStatus": "ACTIVE",
      "createdBy": "platform-team", "approvedBy": "noc-governance-board", "lastReviewedAt": "2026-07-01T00:00:00Z"
    },
    {
      "ruleCode": "R032",
      "name": "Unauthorized access / physical tampering",
      "family": "SAFETY_REGULATORY",
      "familyOrder": 1,
      "description": "Tower intrusion, physical tampering, unauthorized device login, or multi-SIM-fraud signal detected. Routed to the Security Operations Center instead of standard NOC dispatch — this is a security incident, not a network fault.",
      "priorityWeight": 88,
      "severityBand": "Critical",
      "contributionScore": 35,
      "conflictGroup": "priority",
      "conflictsWith": [],
      "isSuppressor": false,
      "nonSuppressible": true,
      "cooldownMinutes": 0,
      "conditions": {
        "or": [
          { "==": [{ "var": "physicalTamperingDetected" }, true] },
          { "==": [{ "var": "unauthorizedAccessDetected" }, true] }
        ]
      },
      "exceptions": null,
      "actions": {
        "priority": "Critical",
        "routeToSecurityOperationsCenter": true,
        "notifyNOC": true
      },
      "mitigations": { "openWarRoom": true },
      "sequencing": null,
      "slaTarget": null,
      "region": null, "tenantId": null, "ruleStatus": "ACTIVE",
      "createdBy": "platform-team", "approvedBy": "noc-governance-board", "lastReviewedAt": "2026-07-01T00:00:00Z"
    },
    {
      "ruleCode": "R001",
      "name": "Mass user impact",
      "family": "NETWORK_IMPACT",
      "familyOrder": 2,
      "description": "More than 10,000 users affected by a single incident.",
      "priorityWeight": 90,
      "severityBand": "Critical",
      "contributionScore": 30,
      "conflictGroup": "priority",
      "conflictsWith": ["R002", "R003"],
      "isSuppressor": false,
      "nonSuppressible": false,
      "cooldownMinutes": 0,
      "conditions": { ">": [{ "var": "affectedUsers" }, 10000] },
      "exceptions": {
        "or": [
          { "==": [{ "var": "context.activeParentIncidentOnSameAsset" }, true] },
          { "==": [{ "var": "context.duplicateOfExistingMajorIncident" }, true] }
        ]
      },
      "actions": {
        "priority": "Critical",
        "dispatchEngineer": true,
        "notifyNOC": true,
        "rerouteTraffic": true,
        "customerNotification": true
      },
      "mitigations": {},
      "sequencing": null,
      "slaTarget": null,
      "region": null, "tenantId": null, "ruleStatus": "ACTIVE",
      "createdBy": "platform-team", "approvedBy": "network-ops-lead", "lastReviewedAt": "2026-07-01T00:00:00Z"
    },
    {
      "ruleCode": "R028",
      "name": "Core network asset failure",
      "family": "NETWORK_IMPACT",
      "familyOrder": 2,
      "description": "Failure at Core Router, International Gateway, 5G Core, Regional POP, or Data Center Switch tier carries a disproportionate blast radius versus edge assets (small cell) and often under-reports affected-user count early in the incident lifecycle. Elevates priority on asset tier alone, independent of currently-known user impact.",
      "priorityWeight": 82,
      "severityBand": "Critical",
      "contributionScore": 35,
      "conflictGroup": "priority",
      "conflictsWith": [],
      "isSuppressor": false,
      "nonSuppressible": false,
      "cooldownMinutes": 0,
      "conditions": {
        "in": [{ "var": "assetTier" }, ["Core Router", "International Gateway", "5G Core", "Regional POP", "Data Center Switch"]]
      },
      "exceptions": null,
      "actions": {
        "priority": "Critical",
        "dispatchEngineer": true,
        "notifyNOC": true,
        "rerouteTraffic": true
      },
      "mitigations": { "openWarRoom": true },
      "sequencing": null,
      "slaTarget": null,
      "region": null, "tenantId": null, "ruleStatus": "ACTIVE",
      "createdBy": "platform-team", "approvedBy": "network-ops-lead", "lastReviewedAt": "2026-07-01T00:00:00Z"
    },
    {
      "ruleCode": "R014",
      "name": "Fiber cut — specialist routing",
      "family": "NETWORK_IMPACT",
      "familyOrder": 2,
      "description": "Fiber cuts are routed to the specialist fiber team and rerouted immediately regardless of SLA tier. Backbone-tier cuts are additionally caught by R028 (asset tier) and typically also trip R001 once downstream user impact is measured.",
      "priorityWeight": 75,
      "severityBand": "High",
      "contributionScore": 30,
      "conflictGroup": null,
      "conflictsWith": [],
      "isSuppressor": false,
      "nonSuppressible": false,
      "cooldownMinutes": 15,
      "conditions": { "==": [{ "var": "incidentType" }, "Fiber Cut"] },
      "exceptions": null,
      "actions": {
        "dispatchEngineer": true,
        "routeToTeam": "fiber-specialist",
        "rerouteTraffic": true,
        "notifyNOC": true
      },
      "mitigations": {},
      "sequencing": null,
      "slaTarget": null,
      "region": null, "tenantId": null, "ruleStatus": "ACTIVE",
      "createdBy": "platform-team", "approvedBy": "network-ops-lead", "lastReviewedAt": "2026-07-01T00:00:00Z"
    },
    {
      "ruleCode": "R012",
      "name": "High network congestion",
      "family": "NETWORK_IMPACT",
      "familyOrder": 2,
      "description": "Network load above 90% capacity triggers automatic traffic rerouting. Does not fire for congestion that is expected/known during an active maintenance window.",
      "priorityWeight": 70,
      "severityBand": "High",
      "contributionScore": 18,
      "conflictGroup": null,
      "conflictsWith": ["R015"],
      "isSuppressor": false,
      "nonSuppressible": false,
      "cooldownMinutes": 15,
      "conditions": { ">": [{ "var": "networkLoad" }, 90] },
      "exceptions": { "==": [{ "var": "maintenanceWindow" }, true] },
      "actions": { "rerouteTraffic": true, "notifyNOC": true },
      "mitigations": {},
      "sequencing": null,
      "slaTarget": null,
      "region": null, "tenantId": null, "ruleStatus": "ACTIVE",
      "createdBy": "platform-team", "approvedBy": "capacity-planning-lead", "lastReviewedAt": "2026-07-01T00:00:00Z"
    },
    {
      "ruleCode": "R002",
      "name": "Moderate user impact",
      "family": "NETWORK_IMPACT",
      "familyOrder": 2,
      "description": "Between 1,000 and 10,000 users affected.",
      "priorityWeight": 60,
      "severityBand": "High",
      "contributionScore": 18,
      "conflictGroup": "priority",
      "conflictsWith": ["R001", "R003"],
      "isSuppressor": false,
      "nonSuppressible": false,
      "cooldownMinutes": 30,
      "conditions": {
        "and": [
          { ">": [{ "var": "affectedUsers" }, 1000] },
          { "<=": [{ "var": "affectedUsers" }, 10000] }
        ]
      },
      "exceptions": {
        "or": [
          { "==": [{ "var": "context.activeParentIncidentOnSameAsset" }, true] },
          { "==": [{ "var": "context.duplicateOfExistingMajorIncident" }, true] }
        ]
      },
      "actions": { "priority": "High", "dispatchEngineer": true, "notifyNOC": true },
      "mitigations": {},
      "sequencing": null,
      "slaTarget": null,
      "region": null, "tenantId": null, "ruleStatus": "ACTIVE",
      "createdBy": "platform-team", "approvedBy": "network-ops-lead", "lastReviewedAt": "2026-07-01T00:00:00Z"
    },
    {
      "ruleCode": "R003",
      "name": "Minor user impact",
      "family": "NETWORK_IMPACT",
      "familyOrder": 2,
      "description": "Fewer than 1,000 users affected.",
      "priorityWeight": 20,
      "severityBand": "Low",
      "contributionScore": 5,
      "conflictGroup": "priority",
      "conflictsWith": ["R001", "R002"],
      "isSuppressor": false,
      "nonSuppressible": false,
      "cooldownMinutes": 60,
      "conditions": { "<": [{ "var": "affectedUsers" }, 1000] },
      "exceptions": null,
      "actions": { "priority": "Low", "notifyNOC": true },
      "mitigations": {},
      "sequencing": null,
      "slaTarget": null,
      "region": null, "tenantId": null, "ruleStatus": "ACTIVE",
      "createdBy": "platform-team", "approvedBy": "network-ops-lead", "lastReviewedAt": "2026-07-01T00:00:00Z"
    },
    {
      "ruleCode": "R007",
      "name": "VIP customers impacted",
      "family": "CUSTOMER_VALUE",
      "familyOrder": 3,
      "description": "One or more VIP-tier customers affected by the incident.",
      "priorityWeight": 85,
      "severityBand": "Critical",
      "contributionScore": 20,
      "conflictGroup": "priority",
      "conflictsWith": [],
      "isSuppressor": false,
      "nonSuppressible": false,
      "cooldownMinutes": 0,
      "conditions": { "==": [{ "var": "vipCustomersAffected" }, true] },
      "exceptions": null,
      "actions": { "priority": "Critical", "notifyAccountManager": true, "customerNotification": true },
      "mitigations": {},
      "sequencing": null,
      "slaTarget": null,
      "region": null, "tenantId": null, "ruleStatus": "ACTIVE",
      "createdBy": "platform-team", "approvedBy": "customer-success-lead", "lastReviewedAt": "2026-07-01T00:00:00Z"
    },
    {
      "ruleCode": "R025",
      "name": "Regulated / critical-sector customer floor",
      "family": "CUSTOMER_VALUE",
      "familyOrder": 3,
      "description": "Incident affects a hospital, financial institution, public-safety, or other regulated/critical-sector customer (government, airport, railway, defense, bank). Forces a minimum severity floor of High regardless of raw affected-user count. Non-suppressible: a maintenance window does not lower this floor.",
      "priorityWeight": 78,
      "severityBand": "High",
      "contributionScore": 22,
      "conflictGroup": "priority",
      "conflictsWith": ["R011"],
      "isSuppressor": false,
      "nonSuppressible": true,
      "cooldownMinutes": 0,
      "conditions": { "==": [{ "var": "context.regulatedSectorCustomerAffected" }, true] },
      "exceptions": null,
      "actions": { "priorityFloor": "High", "notifyNOC": true, "customerNotification": true },
      "mitigations": {},
      "sequencing": null,
      "slaTarget": null,
      "region": null, "tenantId": null, "ruleStatus": "ACTIVE",
      "createdBy": "platform-team", "approvedBy": "customer-success-lead", "lastReviewedAt": "2026-07-01T00:00:00Z"
    },
    {
      "ruleCode": "R004",
      "name": "Gold SLA customer",
      "family": "CUSTOMER_VALUE",
      "familyOrder": 3,
      "description": "Incident affects customers on a Gold SLA tier, which contractually requires a 15-minute response target.",
      "priorityWeight": 80,
      "severityBand": "Critical",
      "contributionScore": 15,
      "conflictGroup": "sla-target",
      "conflictsWith": ["R005", "R006"],
      "isSuppressor": false,
      "nonSuppressible": false,
      "cooldownMinutes": 0,
      "conditions": { "==": [{ "var": "slaTier" }, "Gold"] },
      "exceptions": null,
      "actions": { "targetSLA": "15 minutes", "priority": "Critical" },
      "mitigations": {},
      "sequencing": null,
      "slaTarget": "15 minutes",
      "region": null, "tenantId": null, "ruleStatus": "ACTIVE",
      "createdBy": "platform-team", "approvedBy": "customer-success-lead", "lastReviewedAt": "2026-07-01T00:00:00Z"
    },
    {
      "ruleCode": "R005",
      "name": "Silver SLA customer",
      "family": "CUSTOMER_VALUE",
      "familyOrder": 3,
      "description": "Silver SLA tier — 60-minute response target.",
      "priorityWeight": 50,
      "severityBand": null,
      "contributionScore": 8,
      "conflictGroup": "sla-target",
      "conflictsWith": ["R004", "R006"],
      "isSuppressor": false,
      "nonSuppressible": false,
      "cooldownMinutes": 0,
      "conditions": { "==": [{ "var": "slaTier" }, "Silver"] },
      "exceptions": null,
      "actions": { "targetSLA": "60 minutes" },
      "mitigations": {},
      "sequencing": null,
      "slaTarget": "60 minutes",
      "region": null, "tenantId": null, "ruleStatus": "ACTIVE",
      "createdBy": "platform-team", "approvedBy": "customer-success-lead", "lastReviewedAt": "2026-07-01T00:00:00Z"
    },
    {
      "ruleCode": "R006",
      "name": "Bronze / no SLA",
      "family": "CUSTOMER_VALUE",
      "familyOrder": 3,
      "description": "Default SLA target when no tier is set or tier is Bronze.",
      "priorityWeight": 20,
      "severityBand": null,
      "contributionScore": 2,
      "conflictGroup": "sla-target",
      "conflictsWith": ["R004", "R005"],
      "isSuppressor": false,
      "nonSuppressible": false,
      "cooldownMinutes": 0,
      "conditions": {
        "or": [
          { "==": [{ "var": "slaTier" }, "Bronze"] },
          { "==": [{ "var": "slaTier" }, null] }
        ]
      },
      "exceptions": null,
      "actions": { "targetSLA": "4 hours" },
      "mitigations": {},
      "sequencing": null,
      "slaTarget": "4 hours",
      "region": null, "tenantId": null, "ruleStatus": "ACTIVE",
      "createdBy": "platform-team", "approvedBy": "customer-success-lead", "lastReviewedAt": "2026-07-01T00:00:00Z"
    },
    {
      "ruleCode": "R013",
      "name": "Peak business hours amplifier",
      "family": "TEMPORAL",
      "familyOrder": 4,
      "description": "Incidents during regional peak business/commuting hours (09:00-21:00 local) affecting more than 1,000 users are bumped up one priority tier because business/customer impact is highest.",
      "priorityWeight": 45,
      "severityBand": null,
      "contributionScore": 8,
      "conflictGroup": null,
      "conflictsWith": [],
      "isSuppressor": false,
      "nonSuppressible": false,
      "cooldownMinutes": 0,
      "conditions": {
        "and": [
          { "==": [{ "var": "context.isPeakHoursLocal" }, true] },
          { ">": [{ "var": "affectedUsers" }, 1000] }
        ]
      },
      "exceptions": null,
      "actions": { "priorityBumpOneLevel": true },
      "mitigations": {},
      "sequencing": null,
      "slaTarget": null,
      "region": null, "tenantId": null, "ruleStatus": "ACTIVE",
      "createdBy": "platform-team", "approvedBy": "network-ops-lead", "lastReviewedAt": "2026-07-01T00:00:00Z"
    },
    {
      "ruleCode": "R024",
      "name": "Off-hours / holiday low-impact window",
      "family": "TEMPORAL",
      "familyOrder": 4,
      "description": "Incident occurs during an approved off-hours, weekend, or public-holiday low-traffic window with fewer than 1,000 users affected. Relaxes the SLA target and slightly reduces the risk score, since overnight/holiday dispatch cost is higher and customer impact is proportionally lower.",
      "priorityWeight": 25,
      "severityBand": "Low",
      "contributionScore": -5,
      "conflictGroup": "sla-target",
      "conflictsWith": ["R004", "R005", "R006"],
      "isSuppressor": false,
      "nonSuppressible": false,
      "cooldownMinutes": 0,
      "conditions": {
        "and": [
          { "==": [{ "var": "context.isOffHoursOrHoliday" }, true] },
          { "<": [{ "var": "affectedUsers" }, 1000] }
        ]
      },
      "exceptions": null,
      "actions": { "targetSLA": "8 hours" },
      "mitigations": {},
      "sequencing": null,
      "slaTarget": "8 hours",
      "region": null, "tenantId": null, "ruleStatus": "ACTIVE",
      "createdBy": "platform-team", "approvedBy": "network-ops-lead", "lastReviewedAt": "2026-07-01T00:00:00Z"
    },
    {
      "ruleCode": "R033",
      "name": "Cost optimization — remote fix available",
      "family": "OPERATIONAL_FEASIBILITY",
      "familyOrder": 5,
      "description": "A remote diagnostic/restart path exists and has a historically high success rate for this fault signature. Skip physical dispatch until the remote fix is attempted and fails — the execution plan tries the remote path first, with an automatic fallback to dispatch if it doesn't resolve within the window.",
      "priorityWeight": 35,
      "severityBand": null,
      "contributionScore": 0,
      "conflictGroup": "dispatch-suppression",
      "conflictsWith": ["R008", "R020", "R032"],
      "isSuppressor": true,
      "nonSuppressible": false,
      "cooldownMinutes": 15,
      "conditions": { "==": [{ "var": "context.remoteFixAvailable" }, true] },
      "exceptions": null,
      "actions": { "dispatchEngineer": false },
      "mitigations": { "fallbackToRemoteDiagnostics": true },
      "sequencing": { "tryFirst": "remoteRestart", "fallbackTo": "dispatchEngineer", "fallbackAfterMinutes": 15 },
      "slaTarget": null,
      "region": null, "tenantId": null, "ruleStatus": "ACTIVE",
      "createdBy": "platform-team", "approvedBy": "capacity-planning-lead", "lastReviewedAt": "2026-07-01T00:00:00Z"
    },
    {
      "ruleCode": "R023",
      "name": "Engineer capacity unavailable",
      "family": "OPERATIONAL_FEASIBILITY",
      "familyOrder": 5,
      "description": "No field engineer with the required skill/certification is available in the incident's region within the target SLA window. Falls back to remote diagnostics and queues physical dispatch to the next eligible team (regional pool, then vendor) instead of silently failing to act.",
      "priorityWeight": 55,
      "severityBand": null,
      "contributionScore": 6,
      "conflictGroup": null,
      "conflictsWith": [],
      "isSuppressor": false,
      "nonSuppressible": false,
      "cooldownMinutes": 15,
      "conditions": { "==": [{ "var": "context.engineerCapacityAvailable" }, false] },
      "exceptions": null,
      "actions": { "dispatchEngineer": false, "queueDispatchWhenCapacityAvailable": true, "routeToNextEligibleTeam": true, "notifyNOC": true },
      "mitigations": { "fallbackToRemoteDiagnostics": true },
      "sequencing": null,
      "slaTarget": null,
      "region": null, "tenantId": null, "ruleStatus": "ACTIVE",
      "createdBy": "platform-team", "approvedBy": "capacity-planning-lead", "lastReviewedAt": "2026-07-01T00:00:00Z"
    },
    {
      "ruleCode": "R029",
      "name": "Automation — known firmware bug auto-remediation",
      "family": "OPERATIONAL_FEASIBILITY",
      "familyOrder": 5,
      "description": "Packet loss exceeds 20% and the fault signature matches a known firmware bug in the vendor bug database. The engine restarts the affected interface automatically with no human in the loop, logs the action as an autonomous system action, and re-evaluates the incident afterward.",
      "priorityWeight": 48,
      "severityBand": null,
      "contributionScore": 5,
      "conflictGroup": null,
      "conflictsWith": [],
      "isSuppressor": false,
      "nonSuppressible": false,
      "cooldownMinutes": 10,
      "conditions": {
        "and": [
          { ">": [{ "var": "packetLossPercent" }, 20] },
          { "==": [{ "var": "context.knownFirmwareBugMatch" }, true] }
        ]
      },
      "exceptions": null,
      "actions": { "autoRemediate": true, "autoRemediateAction": "restartInterface", "notifyNOC": true },
      "mitigations": {},
      "sequencing": null,
      "slaTarget": null,
      "region": null, "tenantId": null, "ruleStatus": "ACTIVE",
      "createdBy": "platform-team", "approvedBy": "network-ops-lead", "lastReviewedAt": "2026-07-01T00:00:00Z"
    },
    {
      "ruleCode": "R010",
      "name": "Severe weather dispatch delay",
      "family": "OPERATIONAL_FEASIBILITY",
      "familyOrder": 5,
      "description": "Severe weather in the incident's region makes field dispatch unsafe/impractical. Delays physical dispatch and pauses SLA-breach penalties without downgrading customer communication; falls back to remote diagnostics first.",
      "priorityWeight": 40,
      "severityBand": null,
      "contributionScore": 5,
      "conflictGroup": "dispatch-suppression",
      "conflictsWith": ["R008", "R020"],
      "isSuppressor": true,
      "nonSuppressible": false,
