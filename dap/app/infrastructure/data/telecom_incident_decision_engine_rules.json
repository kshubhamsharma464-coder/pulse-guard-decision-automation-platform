{
  "ruleSetId": "telecom-incident-decision-engine",
  "ruleSetVersion": "1.0.0",
  "namespace": "com.example.telecom.decision",
  "description": "Configurable telecom incident decision rules for NOC, OSS/BSS, service assurance, and major incident handling.",
  "defaultConflictPolicy": "highestPriorityThenHighestConfidence",
  "decisionModel": {
    "outputs": ["decision", "priority", "confidence", "assignmentGroup", "escalationLevel", "reasonCodes", "slaBreachRisk"],
    "priorityScale": ["P1", "P2", "P3", "P4", "P5"]
  },
  "rules": [
    {"id": "HIS001", "version": "1.0.0", "name": "Frequent reboot history", "category": "historical_failure", "priority": 980, "enabled": true, "telecomDomain": ["fault_management", "noc", "rca"],
      "conditions": {"and": [{">=": [{"var": "asset.rebootCount7d"}, 3]}, {">=": [{"var": "asset.rebootCount30d"}, 5]}]},
      "actions": {"decision": "ESCALATE_ENGINEERING", "priority": "P1", "confidence": 0.96, "assignmentGroup": "Engineering L2", "escalationLevel": 2, "slaBreachRisk": "HIGH", "reasonCodes": ["HISTORICAL_REBOOT_PATTERN", "CHRONIC_NODE_INSTABILITY"]},
      "explain": "Asset shows repeated reboot behavior over 7 and 30 days, indicating chronic instability and likely hardware, firmware, or power-related degradation."},
    {"id": "HIS002", "version": "1.0.0", "name": "Previous change failure", "category": "change_related", "priority": 970, "enabled": true, "telecomDomain": ["change_management", "service_assurance", "noc"],
      "conditions": {"and": [{"==": [{"var": "incident.relatedChangeStatus"}, "FAILED"]}, {"==": [{"var": "incident.affectedAsset"}, {"var": "change.assetId"}]}, {"==": [{"var": "change.result"}, "rollback"]}]},
      "actions": {"decision": "ESCALATE_CHANGE_TEAM", "priority": "P1", "confidence": 0.98, "assignmentGroup": "Change Management / Engineering", "escalationLevel": 3, "slaBreachRisk": "HIGH", "reasonCodes": ["FAILED_CHANGE_LINKED", "ROLLBACK_REQUIRED"]},
      "explain": "The incident is linked to a failed change on the same asset, which strongly suggests a change-induced service degradation."},
    {"id": "HIS003", "version": "1.0.0", "name": "Change within 24 hours", "category": "change_related", "priority": 960, "enabled": true, "telecomDomain": ["change_management", "fault_management"],
      "conditions": {"and": [{"<=": [{"var": "incident.ageHoursSinceChange"}, 24]}, {"==": [{"var": "incident.changeImpactFlag"}, true]}]},
      "actions": {"decision": "ESCALATE_ENGINEERING", "priority": "P1", "confidence": 0.93, "assignmentGroup": "Engineering L2", "escalationLevel": 2, "slaBreachRisk": "HIGH", "reasonCodes": ["RECENT_CHANGE_WINDOW", "CHANGE_ASSOCIATED_RISK"]},
      "explain": "A recent change within 24 hours increases the likelihood of regression or misconfiguration."},
    {"id": "HIS004", "version": "1.0.0", "name": "Firmware upgrade recently completed", "category": "software_version", "priority": 955, "enabled": true, "telecomDomain": ["fault_management", "noc"],
      "conditions": {"and": [{"==": [{"var": "asset.firmwareUpgradeCompleted"}, true]}, {"<=": [{"var": "asset.hoursSinceFirmwareUpgrade"}, 48]}, {"in": [{"var": "incident.symptomType"}, ["reboot", "crash", "loss_of_connectivity", "alarm_storm"]]}]},
      "actions": {"decision": "ESCALATE_ENGINEERING", "priority": "P1", "confidence": 0.92, "assignmentGroup": "Engineering L2", "escalationLevel": 2, "slaBreachRisk": "HIGH", "reasonCodes": ["POST_UPGRADE_FAILURE_WINDOW", "FIRMWARE_REGRESSION_RISK"]},
      "explain": "The incident occurred soon after a firmware upgrade and matches typical post-upgrade failure symptoms."},
    {"id": "HIS005", "version": "1.0.0", "name": "Alarm storm previously observed", "category": "alarm_correlation", "priority": 945, "enabled": true, "telecomDomain": ["alarm_correlation", "fault_management", "aops"],
      "conditions": {"and": [{">=": [{"var": "incident.activeAlarmsCount"}, 50]}, {"==": [{"var": "asset.previousAlarmStorm"}, true]}]},
      "actions": {"decision": "CORRELATE_AND_ESCALATE", "priority": "P1", "confidence": 0.9, "assignmentGroup": "NOC Correlation Desk", "escalationLevel": 2, "slaBreachRisk": "HIGH", "reasonCodes": ["ALARM_STORM_HISTORY", "POSSIBLE_PARENT_FAULT"]},
      "explain": "Large alarm volume combined with historical storm behavior suggests a common parent fault or cascading failure."},
    {"id": "HIS006", "version": "1.0.0", "name": "Site repeatedly unreachable", "category": "availability", "priority": 940, "enabled": true, "telecomDomain": ["noc", "service_assurance", "fault_management"],
      "conditions": {"and": [{">=": [{"var": "asset.unreachableCount30d"}, 4]}, {"==": [{"var": "incident.symptomType"}, "site_unreachable"]}]},
      "actions": {"decision": "ESCALATE_FIELD_AND_ENERGY", "priority": "P1", "confidence": 0.95, "assignmentGroup": "Field Ops / Power / RF", "escalationLevel": 2, "slaBreachRisk": "HIGH", "reasonCodes": ["REPEATED_SITE_OUTAGE", "AVAILABILITY_DEGRADATION"]},
      "explain": "Repeated site unreachability is a strong operational signal for power, transmission, or site access issues."},
    {"id": "HIS007", "version": "1.0.0", "name": "Historical packet loss increasing", "category": "performance_degradation", "priority": 930, "enabled": true, "telecomDomain": ["service_assurance", "performance_management"],
      "conditions": {"and": [{">=": [{"var": "metrics.packetLossTrend7d"}, 0.15]}, {">=": [{"var": "metrics.packetLossCurrent"}, 2]}]},
      "actions": {"decision": "INVESTIGATE_TRANSPORT", "priority": "P2", "confidence": 0.89, "assignmentGroup": "Transport Engineering", "escalationLevel": 1, "slaBreachRisk": "MEDIUM", "reasonCodes": ["PACKET_LOSS_TREND", "SERVICE_QUALITY_DEGRADATION"]},
      "explain": "Packet loss is trending upward and has crossed an operationally meaningful threshold."},
    {"id": "HIS008", "version": "1.0.0", "name": "Historical latency increasing", "category": "performance_degradation", "priority": 925, "enabled": true, "telecomDomain": ["service_assurance", "performance_management"],
      "conditions": {"and": [{">=": [{"var": "metrics.latencyTrend7d"}, 0.2]}, {">=": [{"var": "metrics.latencyCurrentMs"}, 100]}]},
      "actions": {"decision": "INVESTIGATE_TRANSPORT", "priority": "P2", "confidence": 0.88, "assignmentGroup": "Transport Engineering", "escalationLevel": 1, "slaBreachRisk": "MEDIUM", "reasonCodes": ["LATENCY_TREND_UP", "DEGRADING_USER_EXPERIENCE"]},
      "explain": "Latency trend and current latency suggest transport congestion, reroute issues, or backhaul impairment."},
    {"id": "HIS009", "version": "1.0.0", "name": "Historical congestion pattern", "category": "capacity", "priority": 920, "enabled": true, "telecomDomain": ["capacity_management", "performance_management", "noc"],
      "conditions": {"and": [{"==": [{"var": "asset.congestionPatternObserved"}, true]}, {">=": [{"var": "metrics.utilizationPercent"}, 85]}]},
      "actions": {"decision": "CAPACITY_REVIEW", "priority": "P2", "confidence": 0.9, "assignmentGroup": "Capacity Planning", "escalationLevel": 1, "slaBreachRisk": "MEDIUM", "reasonCodes": ["RECURRING_CONGESTION", "CAPACITY_PRESSURE"]},
      "explain": "The site has a recurring congestion pattern and current utilization is at a risky level."},
    {"id": "HIS010", "version": "1.0.0", "name": "Capacity exhausted repeatedly", "category": "capacity", "priority": 915, "enabled": true, "telecomDomain": ["capacity_management", "service_assurance"],
      "conditions": {"and": [{">=": [{"var": "asset.capacityExhaustionCount90d"}, 2]}, {">=": [{"var": "metrics.utilizationPercent"}, 95]}]},
      "actions": {"decision": "ESCALATE_CAPACITY_PROGRAM", "priority": "P1", "confidence": 0.97, "assignmentGroup": "Capacity Engineering", "escalationLevel": 2, "slaBreachRisk": "HIGH", "reasonCodes": ["REPEATED_EXHAUSTION", "CAPACITY_EXPANSION_REQUIRED"]},
      "explain": "Repeated capacity exhaustion indicates structural underprovisioning and immediate expansion need."},
    {"id": "HIS011", "version": "1.0.0", "name": "Seasonal outage pattern", "category": "seasonality", "priority": 910, "enabled": true, "telecomDomain": ["service_assurance", "noc"],
      "conditions": {"and": [{"==": [{"var": "context.weatherSeverity"}, "severe"]}, {"in": [{"var": "context.month"}, ["jun", "jul", "aug", "sep"]]}]},
      "actions": {"decision": "ESCALATE_RESILIENCE", "priority": "P2", "confidence": 0.87, "assignmentGroup": "Resilience / Field Ops", "escalationLevel": 1, "slaBreachRisk": "MEDIUM", "reasonCodes": ["SEASONAL_RISK", "WEATHER_IMPACT"]},
      "explain": "The incident occurs in a season historically associated with higher outage risk due to weather."},
    {"id": "HIS012", "version": "1.0.0", "name": "Daily peak-hour recurring failure", "category": "traffic_pattern", "priority": 905, "enabled": true, "telecomDomain": ["performance_management", "service_assurance"],
      "conditions": {"and": [{"in": [{"var": "context.hourOfDay"}, [18, 19, 20, 21, 22]]}, {"==": [{"var": "asset.peakHourFailurePattern"}, true]}]},
      "actions": {"decision": "CAPACITY_AND_OPTIMIZATION", "priority": "P2", "confidence": 0.91, "assignmentGroup": "RAN Optimization", "escalationLevel": 1, "slaBreachRisk": "MEDIUM", "reasonCodes": ["PEAK_HOUR_RECURRING_FAILURE", "TRAFFIC_BURST"]},
      "explain": "The failure pattern is tied to daily peak traffic, suggesting overload or scheduling inefficiency."},
    {"id": "HIS013", "version": "1.0.0", "name": "Weekend recurring outages", "category": "traffic_pattern", "priority": 900, "enabled": true, "telecomDomain": ["noc", "service_assurance"],
      "conditions": {"and": [{"in": [{"var": "context.dayOfWeek"}, ["sat", "sun"]]}, {"==": [{"var": "asset.weekendOutagePattern"}, true]}]},
      "actions": {"decision": "ESCALATE_DOMAIN_OWNER", "priority": "P3", "confidence": 0.84, "assignmentGroup": "Domain Owner", "escalationLevel": 1, "slaBreachRisk": "MEDIUM", "reasonCodes": ["WEEKEND_PATTERN", "RECURRING_OPERATIONAL_WINDOW"]},
      "explain": "Weekend outages often point to maintenance misalignment, staffing gaps, or routine batch jobs."},
    {"id": "HIS014", "version": "1.0.0", "name": "Holiday traffic anomaly", "category": "demand_anomaly", "priority": 895, "enabled": true, "telecomDomain": ["capacity_management", "aops"],
      "conditions": {"and": [{"==": [{"var": "context.isHoliday"}, true]}, {">=": [{"var": "metrics.trafficDeviationPercent"}, 30]}]},
      "actions": {"decision": "MONITOR_AND_SCALE", "priority": "P3", "confidence": 0.8, "assignmentGroup": "Capacity Planning", "escalationLevel": 0, "slaBreachRisk": "MEDIUM", "reasonCodes": ["HOLIDAY_TRAFFIC_ANOMALY", "LOAD_SHIFT"]},
      "explain": "Holiday traffic behavior deviates sharply from baseline and may require temporary scaling."},
    {"id": "HIS015", "version": "1.0.0", "name": "Fiber cut hotspot", "category": "physical_infra", "priority": 985, "enabled": true, "telecomDomain": ["transport", "field_ops", "rca"],
      "conditions": {"and": [{"==": [{"var": "asset.locationHotspotFiberCuts"}, true]}, {"==": [{"var": "incident.symptomType"}, "transmission_down"]}]},
      "actions": {"decision": "DISPATCH_FIELD_EMERGENCY", "priority": "P1", "confidence": 0.99, "assignmentGroup": "Field Ops", "escalationLevel": 3, "slaBreachRisk": "HIGH", "reasonCodes": ["FIBER_CUT_HOTSPOT", "PHYSICAL_TRANSPORT_FAILURE"]},
      "explain": "This location has a known history of fiber cuts and the symptom matches a transmission failure."},
    {"id": "HIS016", "version": "1.0.0", "name": "Vandalism-prone location", "category": "physical_infra", "priority": 975, "enabled": true, "telecomDomain": ["field_ops", "risk_management"],
      "conditions": {"and": [{"==": [{"var": "asset.vandalismRiskFlag"}, true]}, {"==": [{"var": "incident.symptomType"}, "site_down"]}]},
      "actions": {"decision": "ESCALATE_SECURITY_AND_FIELD", "priority": "P1", "confidence": 0.96, "assignmentGroup": "Security / Field Ops", "escalationLevel": 3, "slaBreachRisk": "HIGH", "reasonCodes": ["VANDALISM_RISK", "PHYSICAL_SITE_THREAT"]},
      "explain": "The site is in a known vandalism-prone area and is currently down."},
    {"id": "HIS017", "version": "1.0.0", "name": "Power outage region", "category": "energy", "priority": 965, "enabled": true, "telecomDomain": ["power", "field_ops", "noc"],
      "conditions": {"and": [{"==": [{"var": "context.gridOutageReported"}, true]}, {"==": [{"var": "incident.symptomType"}, "site_down"]}]},
      "actions": {"decision": "ESCALATE_POWER_TEAM", "priority": "P1", "confidence": 0.97, "assignmentGroup": "Power / Field Ops", "escalationLevel": 2, "slaBreachRisk": "HIGH", "reasonCodes": ["GRID_OUTAGE", "POWER_DEPENDENCY"]},
      "explain": "A regional grid outage is a high-probability driver of the site failure."},
    {"id": "HIS018", "version": "1.0.0", "name": "Transmission link degradation", "category": "transport", "priority": 950, "enabled": true, "telecomDomain": ["transport", "performance_management"],
      "conditions": {"and": [{">=": [{"var": "metrics.linkErrorRate"}, 0.5]}, {">=": [{"var": "metrics.linkUtilizationPercent"}, 80]}]},
      "actions": {"decision": "OPTIMIZE_TRANSPORT", "priority": "P2", "confidence": 0.9, "assignmentGroup": "Transport Engineering", "escalationLevel": 1, "slaBreachRisk": "MEDIUM", "reasonCodes": ["LINK_DEGRADATION", "TRANSPORT_STRESS"]},
      "explain": "Error rate and utilization indicate a degrading transmission link."},
    {"id": "HIS019", "version": "1.0.0", "name": "Multiple unresolved RCAs", "category": "governance", "priority": 940, "enabled": true, "telecomDomain": ["rca", "service_assurance", "governance"],
      "conditions": {"and": [{">=": [{"var": "asset.unresolvedRcaCount90d"}, 2]}, {"==": [{"var": "incident.isNew"}, true]}]},
      "actions": {"decision": "ESCALATE_GOVERNANCE", "priority": "P2", "confidence": 0.92, "assignmentGroup": "Problem Management", "escalationLevel": 2, "slaBreachRisk": "MEDIUM", "reasonCodes": ["UNRESOLVED_RCA_BACKLOG", "REPEAT_FAILURE_WITHOUT_FIX"]},
      "explain": "The site has multiple unresolved RCAs, indicating weak problem closure discipline."},
    {"id": "HIS020", "version": "1.0.0", "name": "Incident closed without RCA", "category": "governance", "priority": 935, "enabled": true, "telecomDomain": ["rca", "incident_management"],
      "conditions": {"and": [{"==": [{"var": "incident.previousIncidentClosedWithoutRca"}, true]}, {"==": [{"var": "incident.sameSignatureAsPrevious"}, true]}]},
      "actions": {"decision": "REOPEN_AND_ESCALATE", "priority": "P1", "confidence": 0.95, "assignmentGroup": "Problem Management", "escalationLevel": 2, "slaBreachRisk": "HIGH", "reasonCodes": ["NO_RCA_PREVIOUSLY", "RECURRING_SIGNATURE"]},
      "explain": "The issue recurred after a previous closure without root-cause analysis."},
    {"id": "HIS021", "version": "1.0.0", "name": "Auto-close failure rate high", "category": "workflow_quality", "priority": 930, "enabled": true, "telecomDomain": ["incident_management", "automation"],
      "conditions": {"and": [{">=": [{"var": "asset.autoCloseFailureRate30d"}, 0.25]}, {"==": [{"var": "incident.autoClosed"}, true]}]},
      "actions": {"decision": "KEEP_OPEN_FOR_REVIEW", "priority": "P2", "confidence": 0.9, "assignmentGroup": "NOC Supervisor", "escalationLevel": 1, "slaBreachRisk": "MEDIUM", "reasonCodes": ["AUTO_CLOSE_UNRELIABLE", "QUALITY_CONTROL_REQUIRED"]},
      "explain": "Automated closure has a high failure rate, so manual review is safer."},
    {"id": "HIS022", "version": "1.0.0", "name": "Low MTBSI", "category": "reliability", "priority": 975, "enabled": true, "telecomDomain": ["reliability", "service_assurance", "rca"],
      "conditions": {"and": [{"<": [{"var": "asset.mtbsiHours"}, 72]}, {">=": [{"var": "incident.serviceImpactMinutes"}, 10]}]},
      "actions": {"decision": "ESCALATE_ENGINEERING", "priority": "P1", "confidence": 0.98, "assignmentGroup": "Engineering L3", "escalationLevel": 3, "slaBreachRisk": "HIGH", "reasonCodes": ["LOW_MTBSI", "SERVICE_RELIABILITY_DEGRADATION"]},
      "explain": "Mean Time Between Service Impact is below acceptable levels, showing persistent instability."},
    {"id": "HIS023", "version": "1.0.0", "name": "Rising customer complaints", "category": "customer_impact", "priority": 945, "enabled": true, "telecomDomain": ["bss", "customer_experience", "service_assurance"],
      "conditions": {"and": [{">=": [{"var": "customer.complaints24h"}, 20]}, {">=": [{"var": "customer.complaintTrend7d"}, 0.2]}]},
      "actions": {"decision": "ESCALATE_MAJOR_INCIDENT", "priority": "P1", "confidence": 0.94, "assignmentGroup": "Major Incident Management", "escalationLevel": 2, "slaBreachRisk": "HIGH", "reasonCodes": ["CUSTOMER_COMPLAINT_SPIKE", "WIDESPREAD_IMPACT"]},
      "explain": "Customer complaints are increasing sharply, suggesting material business impact."},
    {"id": "HIS024", "version": "1.0.0", "name": "Frequent handover failures", "category": "mobility", "priority": 925, "enabled": true, "telecomDomain": ["ran", "mobility", "performance_management"],
      "conditions": {"and": [{">=": [{"var": "metrics.handoverFailureRate"}, 5]}, {"==": [{"var": "asset.sameSiteRepeat"}, true]}]},
      "actions": {"decision": "RAN_PARAMETER_TUNING", "priority": "P2", "confidence": 0.9, "assignmentGroup": "RAN Engineering", "escalationLevel": 1, "slaBreachRisk": "MEDIUM", "reasonCodes": ["HANDOVER_FAILURE_PATTERN", "CELL_EDGE_IMPAIRMENT"]},
      "explain": "Handover failures at the same site indicate RF, neighbor, or parameter issues."},
    {"id": "HIS025", "version": "1.0.0", "name": "Recurring backhaul congestion", "category": "backhaul", "priority": 950, "enabled": true, "telecomDomain": ["transport", "backhaul", "capacity_management"],
      "conditions": {"and": [{"==": [{"var": "asset.backhaulCongestionRecurring"}, true]}, {">=": [{"var": "metrics.backhaulUtilizationPercent"}, 85]}]},
      "actions": {"decision": "ESCALATE_TRANSPORT_CAPACITY", "priority": "P1", "confidence": 0.96, "assignmentGroup": "Transport Capacity Team", "escalationLevel": 2, "slaBreachRisk": "HIGH", "reasonCodes": ["RECURRING_BACKHAUL_CONGESTION", "BACKHAUL_BOTTLENECK"]},
      "explain": "Repeated backhaul congestion is a structural transport constraint, not a transient symptom."},
    {"id": "HIS026", "version": "1.0.0", "name": "CPU spikes before outage", "category": "resource_pressure", "priority": 940, "enabled": true, "telecomDomain": ["noc", "aops", "performance_management"],
      "conditions": {"and": [{">=": [{"var": "metrics.cpuSpikeCount24h"}, 3]}, {"==": [{"var": "asset.outageFollowedByCpuSpike"}, true]}]},
      "actions": {"decision": "ESCALATE_PLATFORM_ENGINEERING", "priority": "P1", "confidence": 0.93, "assignmentGroup": "Platform / Core Engineering", "escalationLevel": 2, "slaBreachRisk": "HIGH", "reasonCodes": ["CPU_PRESSURE_PRECEDES_OUTAGE", "RESOURCE_EXHAUSTION"]},
      "explain": "CPU spikes frequently precede outages, indicating resource starvation or software defects."},
    {"id": "HIS027", "version": "1.0.0", "name": "Memory leak pattern", "category": "software_defect", "priority": 945, "enabled": true, "telecomDomain": ["fault_management", "software_ops"],
      "conditions": {"and": [{"==": [{"var": "asset.memoryLeakPatternObserved"}, true]}, {">=": [{"var": "metrics.memoryUsagePercent"}, 85]}]},
      "actions": {"decision": "ESCALATE_VENDOR_AND_ENGINEERING", "priority": "P1", "confidence": 0.97, "assignmentGroup": "Vendor Support / Engineering", "escalationLevel": 3, "slaBreachRisk": "HIGH", "reasonCodes": ["MEMORY_LEAK", "SOFTWARE_DEGRADATION"]},
      "explain": "A memory leak pattern strongly indicates a software defect requiring engineering or vendor intervention."},
    {"id": "HIS028", "version": "1.0.0", "name": "Repeat synchronization failures", "category": "timing", "priority": 955, "enabled": true, "telecomDomain": ["transport", "timing", "ran"],
      "conditions": {"and": [{">=": [{"var": "asset.syncFailureCount24h"}, 3]}, {"in": [{"var": "incident.symptomType"}, ["sync_loss", "gps_drift", "timing_alarm"]]}]},
      "actions": {"decision": "ESCALATE_TIMING_TEAM", "priority": "P1", "confidence": 0.98, "assignmentGroup": "Timing / Sync Engineering", "escalationLevel": 2, "slaBreachRisk": "HIGH", "reasonCodes": ["REPEATED_SYNC_FAILURE", "TIMING_RISK"]},
      "explain": "Repeated synchronization failures can destabilize RAN, transport, and service continuity."},
    {"id": "HIS029", "version": "1.0.0", "name": "Repeat GPS clock failures", "category": "timing", "priority": 960, "enabled": true, "telecomDomain": ["ran", "timing", "fault_management"],
      "conditions": {"and": [{"==": [{"var": "asset.gpsClockRepeatFailure"}, true]}, {">=": [{"var": "metrics.gpsClockAlarmCount7d"}, 2]}]},
      "actions": {"decision": "DISPATCH_TIMING_FIELD", "priority": "P1", "confidence": 0.98, "assignmentGroup": "Timing Field Engineering", "escalationLevel": 3, "slaBreachRisk": "HIGH", "reasonCodes": ["GPS_CLOCK_REPEAT_FAILURE", "TIMING_SOURCE_INSTABILITY"]},
      "explain": "Repeated GPS clock failures are a serious timing fault and require immediate specialist attention."},
    {"id": "HIS030", "version": "1.0.0", "name": "Vendor patch available", "category": "remediation", "priority": 900, "enabled": true, "telecomDomain": ["vendor_management", "software_ops", "rca"],
      "conditions": {"and": [{"==": [{"var": "asset.vendorPatchAvailable"}, true]}, {"==": [{"var": "incident.matchesKnownIssue"}, true]}]},
      "actions": {"decision": "PLAN_PATCH_DEPLOYMENT", "priority": "P2", "confidence": 0.91, "assignmentGroup": "Engineering / Vendor Support", "escalationLevel": 1, "slaBreachRisk": "MEDIUM", "reasonCodes": ["PATCH_AVAILABLE", "KNOWN_ISSUE_MATCH"]},
      "explain": "A vendor patch exists for the known issue, making patch planning the appropriate next step."}
  ]
}
